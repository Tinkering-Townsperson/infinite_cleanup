movement_speed = 2.3

// Create Event
wiggle_timer = 0; // A timer to track the position in the sine wave
wiggle_frequency = 0.4; // How fast the sprite wiggles (higher = faster)
wiggle_amplitude = 2; // How many pixels the sprite moves from its center (more = dramatic wiggle)
is_wiggling = false; // A flag to start/stop the wiggle